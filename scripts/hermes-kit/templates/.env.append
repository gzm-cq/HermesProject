# ===== 由 hermes-kit install.sh 追加，请勿手动修改本区块 =====
# Hermes-Kit 环境变量
# 所有 kit 相关变量以 HERMES_KIT_ 前缀命名，避免与 Hermes 本身冲突

# 飞书通知 chat_id（必填，留空则跳过飞书通知）
HERMES_KIT_HOME_CHAT_ID=

# 记忆清理（0=apply, 1=dry-run）
HERMES_KIT_MEM_DRY_RUN=0

# 聚类分析最小簇大小
HERMES_KIT_CLUSTER_MIN_SIZE=3

# 知识树 consolidate 最小子节点数
HERMES_KIT_KT_MIN_SUB_NODES=10

# LiteLLM 地址
HERMES_KIT_LITELLM_URL=http://127.0.0.1:4142

# PostgreSQL 连接（请根据实际环境修改密码）
HERMES_KIT_PG_HOST=127.0.0.1
HERMES_KIT_PG_PORT=5434
HERMES_KIT_PG_USER=postgres
# HERMES_KIT_PG_PASSWORD=your_password_here
