# p0-benchmark 部署清单
# 源:  scripts/p0-benchmark/
# 标:  /root/.hermes/scripts/p0-benchmark/
# 影响: Benchmark 性能验证脚本；无需重启服务
#
# 语法: 每行一个 glob 模式（相对项目根）；以 ! 开头为排除；# 起始为注释。

# === Include ===
src/**/*.py
config/**/*.yaml
pyproject.toml
README.md

# === Exclude ===
!**/__pycache__/**
!**/*.pyc
!**/.pytest_cache/**
!**/*.egg-info/**
!**/tests/**
!**/test_*.py
!**/reports/**
